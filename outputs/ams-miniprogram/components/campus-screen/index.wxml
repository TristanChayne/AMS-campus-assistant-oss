
<view class="screen {{dark?'dark':''}}" style="--campus:{{theme}}">
 <view class="heading"><view><text class="eyebrow">XJTLU / CAMPUS DAY</text><view class="title">{{role==='today'?'今日课表':role==='records'?'签到记录':role==='leave'?'请假':role==='reservations'?'预约':role==='settings'?'设置':'课程明细'}}</view></view><view class="tools" wx:if="{{role==='today'||role==='records'||role==='leave'}}"><button wx:if="{{role==='today'}}" bindtap="pending" aria-label="我的西浦码">▦</button><button bindtap="settings" aria-label="设置">⚙</button></view></view>
 <view wx:if="{{!logged}}" class="empty"><view class="title">连接你的校园日常</view><text>登录学校账号后查看课程与记录</text><view class="note">读取适配版 0.2.4</view><button class="primary" bindtap="login">学校账号登录</button><button class="secondary" bindtap="diagnostics">复制登录状态诊断</button></view>
 <block wx:else>
 <view wx:if="{{loading}}" class="note">正在读取学校数据…</view><view wx:if="{{error}}" class="notice">{{error}}<button bindtap="refresh">重新读取</button></view>
 <block wx:if="{{role==='today'}}">
 <view class="date-head">{{view.month}}</view><view class="week"><button wx:for="{{view.days}}" wx:key="date" class="day {{view.selected===item.date?'selected':''}}" bindtap="selectDay" data-date="{{item.date}}"><text>{{item.label}}</text><view>{{item.date}}</view></button></view>
 <view wx:if="{{view.focus}}" class="hero"><view class="hero-top"><text>{{view.focusLabel}}　{{view.focus.moduleCode}}</text><text wx:if="{{view.today}}">{{view.focus.minutes}} 分钟{{view.focus.active?'后结束':'后开始'}}</text></view><view class="hero-title">{{view.focus.moduleTitle}}</view><text>{{view.focus.start}} — {{view.focus.end}}</text><view class="destination"><text class="place">⌖ {{view.focus.room}}</text><text>上课地点</text></view></view>
 <view class="actions"><button bindtap="pending">⌗　扫码签到</button><button bindtap="pending">▤　Code 签到</button></view>
 <view class="section"><text>接下来的课</text><text class="note">{{view.count||0}} 节课</text></view>
 <view wx:for="{{view.remaining}}" wx:key="index" class="lesson"><view class="times">{{item.start}}<text>{{item.end}}</text></view><button class="card" bindtap="course" data-index="{{index}}"><view class="row note"><text>{{item.moduleCode}}</text><text>{{item.state}}</text></view><view class="course-title">{{item.moduleTitle}}</view><view class="room">⌖ {{item.room}} <text>›</text></view></button></view>
 <view wx:if="{{loaded&&!view.remaining.length}}" class="empty"><view>{{view.ended.length?'当天的课都结束了':'当天没有课程'}}</view></view><button wx:if="{{view.ended.length}}" class="ended" bindtap="toggleEnded">已结束 · {{view.ended.length}} 节 {{expanded?'收起':'展开'}}</button><view wx:if="{{expanded}}" wx:for="{{view.ended}}" wx:key="index" class="card muted" bindtap="course" data-index="{{index}}" data-ended="{{true}}">{{item.start}}　{{item.moduleTitle}}</view><button class="clock-report" bindtap="diagnostics">复制课表日期诊断</button><view class="quote">把脚步交给今天，把远方留给自己。</view>
 </block>
 <block wx:if="{{role==='records'}}"><view wx:if="{{loaded}}" class="overview"><text>本学期 · 综合出勤率</text><view>{{overall}}</view></view><button wx:for="{{rows}}" wx:key="index" class="card attendance" bindtap="detail" data-index="{{index}}"><view class="row"><view><text class="note">{{item.moduleCode}}</text><view class="course-title">{{item.title}}</view></view><view class="ring">{{item.percent}}</view></view><view class="stats"><view>{{item.classHour}}<text>总课时</text></view><view>{{item.signClassHour}}<text>出勤</text></view><view>{{item.absences}}<text>缺勤</text></view><view>{{item.leaveClassHour}}<text>请假</text></view></view></button></block>
 <block wx:if="{{role==='leave'}}"><button class="secondary" bindtap="pending">＋ 新建请假申请</button><view wx:for="{{rows}}" wx:key="index" class="card"><view class="row note"><text>{{item.leaveOdd}}</text><text>{{item.label}}</text></view><view class="course-title">{{item.startDate}} 至 {{item.endDate}}</view><text class="note">创建于 {{item.createTime}}</text></view></block>
 <block wx:if="{{role==='detail'}}"><view wx:for="{{rows}}" wx:key="index" class="card"><view class="row"><text>{{item.date}}</text><text>{{item.label}}</text></view><text class="note">{{item.moduleTypeGroup}}　{{item.signTime}}</text></view><button wx:if="{{more}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多</button></block>
 <view wx:if="{{loaded&&!error&&!rows.length&&(role==='records'||role==='leave'||role==='detail')}}" class="empty">暂无记录</view>
 <block wx:if="{{role==='reservations'}}"><button wx:for="{{['图书馆座位','讨论室','区间车','我的预约']}}" wx:key="*this" class="card reservation" bindtap="pending">{{item}}<text>›</text></button><view class="note">预约业务尚未接入，当前保留界面入口。</view></block>
 <block wx:if="{{role==='settings'}}"><view class="card"><text class="note">当前学校账号</text><view class="course-title" selectable>{{account}}</view><button class="logout" bindtap="logout">退出登录</button></view><view class="card"><view class="section">外观</view><view class="actions"><button wx:for="{{['light','dark','system']}}" wx:key="*this" data-mode="{{item}}" bindtap="appearance">{{item==='light'?'浅色':item==='dark'?'深色':'系统'}}</button></view><view class="section">主题色</view><view class="themes"><button wx:for="{{['blue','green','dusk','teal','sage','smoke','graphite','rose','wheat']}}" wx:key="*this" bindtap="theme" data-key="{{item}}">{{item==='blue'?'校园蓝':item==='green'?'青绿':item==='dusk'?'暮蓝':item==='teal'?'松石青':item==='sage'?'鼠尾草绿':item==='smoke'?'烟紫':item==='graphite'?'石墨灰':item==='rose'?'玫瑰粉':'麦穗金'}}</button></view></view><button class="secondary" bindtap="pending">校园地图</button><button class="secondary" bindtap="contact">复制联系邮箱</button><view class="quote">AMS 校园助手 · 0.2.4<br/>由 Tristan Chayne 制作</view></block>
 </block>
<view wx:if="{{courseSheet}}" class="sheet-mask" bindtap="closeCourse"><view class="course-sheet" catchtap="stopTap"><view class="sheet-handle"></view><view class="row"><text class="note">{{courseSheet.moduleCode}}</text><button class="sheet-x" bindtap="closeCourse" aria-label="关闭课程详情">×</button></view><view class="sheet-title">{{courseSheet.moduleTitle}}</view><view class="sheet-row"><text>上课日期</text><text>{{view.selected}}</text></view><view class="sheet-row"><text>上课时间</text><text>{{courseSheet.start}} — {{courseSheet.end}}</text></view><view class="sheet-row"><text>教室</text><text selectable>{{courseSheet.room}}</text></view><view class="sheet-row"><text>课程状态</text><text>{{courseSheet.state}}</text></view><button class="primary" bindtap="closeCourse">完成</button></view></view></view>
