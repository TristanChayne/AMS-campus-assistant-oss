
.screen{--paper:#f5f6f8;--ink:#18233a;--pencil:#69758a;--line:#e1e6ed;--panel:#fafbfd;background:var(--paper);color:var(--ink);min-height:100vh;padding:32rpx 44rpx 60rpx;box-sizing:border-box}.dark{--paper:#141922;--ink:#eef2f7;--pencil:#a9b6c6;--line:#343d49;--panel:#202630}.heading,.row,.section,.destination,.date-head{display:flex;align-items:center;justify-content:space-between}.heading{margin-bottom:16rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:var(--pencil)}.title{font-size:54rpx;font-weight:700;line-height:1.4}.tools{display:flex}.tools button{background:transparent;color:var(--campus);width:80rpx;padding:0;font-size:42rpx;min-height:88rpx}.date-head{font-size:28rpx;font-weight:600;margin:12rpx 0 24rpx}.week{white-space:nowrap;margin-bottom:40rpx}.day{display:inline-block;width:31%;margin-right:2%;background:transparent;color:var(--pencil);padding:18rpx 0;border-radius:26rpx;font-size:22rpx}.day view{font-size:32rpx;font-weight:600;margin-top:10rpx}.day.selected{background:var(--campus);color:white}.hero{background:var(--campus);color:white;border-radius:40rpx;padding:42rpx 44rpx;margin-bottom:40rpx;font-size:28rpx}.hero-top{display:flex;justify-content:space-between;font-size:22rpx;color:#d0dbef;gap:12rpx}.hero-title{font-size:38rpx;line-height:1.4;font-weight:600;margin:28rpx 0 24rpx}.destination{border-top:1rpx solid #ffffff25;margin-top:34rpx;padding-top:32rpx;gap:16rpx;font-size:22rpx;color:#c6d3eb}.place{font-size:50rpx;font-weight:700;color:white;overflow-wrap:anywhere}.actions{display:flex;gap:20rpx;margin-bottom:40rpx}.actions button{flex:1;padding:26rpx 8rpx;background:var(--panel);border:1rpx solid var(--line);color:var(--ink);font-size:26rpx;min-height:96rpx}.actions button:first-child{color:var(--campus)}.section{font-size:30rpx;font-weight:600;margin:28rpx 0}.note{font-size:24rpx;font-weight:400;color:var(--pencil);line-height:1.7}.lesson{display:flex;gap:24rpx;margin-bottom:24rpx}.times{width:96rpx;flex-shrink:0;font-size:30rpx;padding-top:34rpx;font-weight:600}.times text{display:block;font-size:24rpx;color:var(--pencil);margin-top:8rpx;font-weight:400}.card{background:var(--panel);border:1rpx solid var(--line);border-radius:30rpx;padding:32rpx;text-align:left;margin-bottom:24rpx;box-sizing:border-box}.lesson .card{flex:1;min-width:0;margin:0}.course-title{font-size:30rpx;line-height:1.45;font-weight:600;margin:14rpx 0 22rpx}.room{font-size:30rpx;font-weight:700;display:flex;justify-content:space-between}.room text{color:var(--pencil)}.quote{border-top:1rpx solid var(--line);margin-top:40rpx;padding:32rpx 0;font-size:24rpx;line-height:1.8;color:var(--pencil)}.empty{padding:70rpx 0;text-align:center;color:var(--pencil);line-height:2}.primary{background:var(--campus);color:white;margin-top:32rpx;padding:26rpx}.secondary{background:var(--panel);color:var(--ink);border:1rpx solid var(--line);padding:26rpx;margin-bottom:28rpx}.overview{padding:20rpx 0 36rpx;color:var(--pencil);font-size:24rpx}.overview view{font-size:64rpx;color:var(--ink);font-weight:600;margin-top:12rpx}.attendance{width:100%}.ring{border:8rpx solid var(--campus);border-radius:50%;width:132rpx;height:132rpx;display:flex;justify-content:center;align-items:center;flex-shrink:0;font-size:27rpx;margin-left:20rpx}.stats{display:flex;justify-content:space-between;border-top:1rpx solid var(--line);padding-top:26rpx;margin-top:28rpx;font-size:34rpx}.stats text{display:block;font-size:22rpx;color:var(--pencil)}.notice{background:var(--panel);border:1rpx solid var(--line);padding:24rpx;border-radius:20rpx;color:var(--pencil);margin-bottom:24rpx}.notice button{color:var(--campus);background:transparent}.ended{font-size:24rpx;background:transparent;color:var(--pencil);text-align:left;padding:24rpx 0}.reservation{display:flex;width:100%;justify-content:space-between;padding:40rpx 32rpx}.themes{display:flex;flex-wrap:wrap;gap:12rpx}.themes button{font-size:24rpx;background:var(--paper);color:var(--ink);padding:20rpx}.logout{color:#a15b46;background:transparent;text-align:left;padding:16rpx 0}.muted{color:var(--pencil)}

/* Explicitly reset native button defaults inside isolated components. */
button{margin:0;box-sizing:border-box;color:var(--ink);font-size:28rpx;line-height:1.5;font-weight:400}button::after{border:0}
.card{color:var(--ink);width:100%;margin-left:0;margin-right:0}.course-title,.room,.stats,.ring{color:var(--ink)}
.attendance .row>view:first-child{min-width:0;flex:1}.attendance .course-title{overflow-wrap:anywhere;font-size:30rpx}.stats>view{flex:1;min-width:0}
.week{display:flex;gap:16rpx;overflow-x:auto;white-space:normal}.day{flex:1;min-width:140rpx;width:auto;margin:0;flex-shrink:0}.day.selected{color:white}
.lesson .card{width:auto}.reservation{width:100%;margin:0 0 24rpx}.actions button{margin:0}.primary{color:white}.clock-report{background:transparent;color:var(--pencil);font-size:22rpx;margin:24rpx 0;text-align:left;padding:0}
.sheet-mask{position:fixed;inset:0;background:#17233a66;z-index:1000;display:flex;align-items:flex-end}.course-sheet{background:var(--panel);color:var(--ink);width:100%;border-radius:40rpx 40rpx 0 0;padding:20rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sheet-handle{width:70rpx;height:7rpx;border-radius:7rpx;background:var(--line);margin:0 auto 22rpx}.sheet-x{background:transparent;color:var(--pencil);font-size:42rpx;width:88rpx;height:88rpx;padding:0}.sheet-title{font-size:40rpx;font-weight:600;line-height:1.4;margin:10rpx 0 28rpx}.sheet-row{display:flex;justify-content:space-between;gap:24rpx;border-top:1rpx solid var(--line);padding:24rpx 0;font-size:28rpx}.sheet-row text:first-child{color:var(--pencil);flex-shrink:0}.sheet-row text:last-child{text-align:right}.course-sheet .primary{margin-top:24rpx}
