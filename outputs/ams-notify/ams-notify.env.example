# Copy to /etc/ams-notify/ams-notify.env on the server (chmod 600). Never commit the real file or key.
# APNs token auth key (.p8) from Apple Developer > Keys, placed at /etc/ams-notify/keys/AuthKey.p8
APNS_KEY_PATH=/run/keys/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
# Comma-separated app bundle IDs allowed to register
AMS_BUNDLE_IDS=cn.xjtlu.ams.ios
# ADMIN-BE-001 activation runtime. Use the ORIGINAL values from the Tencent deployment; never regenerate.
# While empty, /api/activate, /api/check, /api/client/check and /api/admin/* answer 503.
SIGNING_KEY=
CODE_PEPPER=
SESSION_SECRET=
# Public origin used for the admin Origin check
AMS_PUBLIC_ORIGIN=https://ams.tristanchayne.com
# Shared secret the Tencent forwarding function sends so the real client IP is trusted for rate limits
AMS_PROXY_KEY=